  "scripts": {
    "test": "node test-core.mjs",
    "build": "node build-doc.mjs",
    "bundle": "node bundle-offline.mjs"
  },
  "keywords": [
    "docx",
    "omml",
    "latex",
    "katex",
    "mathml",
    "word",
    "converter",
    "offline"
  ],
  "author": "mikoi6",
  "license": "MIT",
  "devDependencies": {
    "katex": "^0.16.11",
    "mathjax-full": "^3.2.2"
  }
}
